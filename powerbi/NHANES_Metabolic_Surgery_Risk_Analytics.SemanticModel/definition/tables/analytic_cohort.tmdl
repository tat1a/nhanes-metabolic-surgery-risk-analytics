table analytic_cohort
	lineageTag: 924a9ed9-2572-4e8a-b19d-06c101aadb4b

	measure 'Analytic Cohort Adults' = COUNTROWS ( analytic_cohort )
		formatString: #,0
		displayFolder: 01 Eligibility KPIs
		lineageTag: 704bf776-4860-45d9-b867-3152bfc1e58d

	measure 'Weighted Population' = SUM ( analytic_cohort[mec_exam_weight] )
		formatString: #,0.0
		displayFolder: 01 Eligibility KPIs
		lineageTag: 4a1e1a67-f63c-440c-a4d1-5df28d553437

	measure 'Weighted Eligible Population' = SUMX ( analytic_cohort, analytic_cohort[mec_exam_weight] * analytic_cohort[guideline_like_eligible] )
		formatString: #,0.0
		displayFolder: 01 Eligibility KPIs
		lineageTag: cde1ae70-059d-4495-bc98-ba264c543ae1

	measure 'Weighted Eligibility Rate' = DIVIDE ( [Weighted Eligible Population], [Weighted Population] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Eligibility KPIs
		lineageTag: a8520006-e0f5-41f4-a460-e471d15959fa

	measure 'Weighted BMI >=35 Rate' = DIVIDE ( SUMX ( analytic_cohort, analytic_cohort[mec_exam_weight] * analytic_cohort[meets_bmi_35_recommended] ), [Weighted Population] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Eligibility KPIs
		lineageTag: 1283f3cd-4fdb-4cd6-98f2-677ef7f7c6b7

	measure 'Weighted BMI 30-34.9 + Metabolic Disease Rate' = DIVIDE ( SUMX ( analytic_cohort, analytic_cohort[mec_exam_weight] * analytic_cohort[bmi_30_349_with_metabolic_disease] ), [Weighted Population] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Eligibility KPIs
		lineageTag: cb55c50e-3da8-445e-b909-75ce154d6a5f

	measure 'Weighted Mean BMI' = DIVIDE ( SUMX ( analytic_cohort, analytic_cohort[mec_exam_weight] * analytic_cohort[bmi] ), [Weighted Population] )
		formatString: 0.0
		displayFolder: 01 Eligibility KPIs
		lineageTag: 6094affe-4bc6-49f2-8795-fe8de8cf5976

	measure 'Eligible Weighted Mean BMI' = DIVIDE ( SUMX ( FILTER ( analytic_cohort, analytic_cohort[guideline_like_eligible] = 1 ), analytic_cohort[mec_exam_weight] * analytic_cohort[bmi] ), SUMX ( FILTER ( analytic_cohort, analytic_cohort[guideline_like_eligible] = 1 ), analytic_cohort[mec_exam_weight] ) )
		formatString: 0.0
		displayFolder: 01 Eligibility KPIs
		lineageTag: 8c775791-af75-4564-9ed8-19634169ca85

	measure 'Weighted Diabetes Signal Rate' = DIVIDE ( SUMX ( analytic_cohort, analytic_cohort[mec_exam_weight] * analytic_cohort[diabetes_or_lab_range] ), [Weighted Population] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Risk Signals
		lineageTag: 43325dab-a0ba-410a-9a99-70cbe6b4202b

	measure 'Weighted Hypertension Signal Rate' = DIVIDE ( SUMX ( analytic_cohort, analytic_cohort[mec_exam_weight] * analytic_cohort[hypertension_or_treatment] ), [Weighted Population] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Risk Signals
		lineageTag: b08db69d-74d7-4fdd-869c-5d6a4896fc9d

	measure 'Weighted Dyslipidemia Signal Rate' = DIVIDE ( SUMX ( analytic_cohort, analytic_cohort[mec_exam_weight] * analytic_cohort[dyslipidemia_signal] ), [Weighted Population] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Risk Signals
		lineageTag: 199af219-0884-4951-a580-12b7fd5ff420

	measure 'Weighted Central Adiposity Signal Rate' = DIVIDE ( SUMX ( analytic_cohort, analytic_cohort[mec_exam_weight] * analytic_cohort[central_adiposity_signal] ), [Weighted Population] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Risk Signals
		lineageTag: 5652cadc-e0c8-4545-adfd-54b51d32d8e2

	measure 'Eligible Adults With 2+ Risk Signals' = DIVIDE ( SUMX ( FILTER ( analytic_cohort, analytic_cohort[guideline_like_eligible] = 1 ), analytic_cohort[mec_exam_weight] * IF ( analytic_cohort[cardiometabolic_risk_count] >= 2, 1, 0 ) ), SUMX ( FILTER ( analytic_cohort, analytic_cohort[guideline_like_eligible] = 1 ), analytic_cohort[mec_exam_weight] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Risk Signals
		lineageTag: d3f4c1ee-1238-4e80-88f2-8e7ffa801e0d

	measure 'Eligible Diabetes Signal Rate' = DIVIDE ( SUMX ( FILTER ( analytic_cohort, analytic_cohort[guideline_like_eligible] = 1 ), analytic_cohort[mec_exam_weight] * analytic_cohort[diabetes_or_lab_range] ), SUMX ( FILTER ( analytic_cohort, analytic_cohort[guideline_like_eligible] = 1 ), analytic_cohort[mec_exam_weight] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Risk Signals
		lineageTag: b7ebc395-b1e1-4ede-b3a5-ab84664bd3e0

	measure 'Eligible Hypertension Signal Rate' = DIVIDE ( SUMX ( FILTER ( analytic_cohort, analytic_cohort[guideline_like_eligible] = 1 ), analytic_cohort[mec_exam_weight] * analytic_cohort[hypertension_or_treatment] ), SUMX ( FILTER ( analytic_cohort, analytic_cohort[guideline_like_eligible] = 1 ), analytic_cohort[mec_exam_weight] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Risk Signals
		lineageTag: 6c52b967-ec8b-4aa1-8fa3-07fd26533a03

	measure 'Eligible Dyslipidemia Signal Rate' = DIVIDE ( SUMX ( FILTER ( analytic_cohort, analytic_cohort[guideline_like_eligible] = 1 ), analytic_cohort[mec_exam_weight] * analytic_cohort[dyslipidemia_signal] ), SUMX ( FILTER ( analytic_cohort, analytic_cohort[guideline_like_eligible] = 1 ), analytic_cohort[mec_exam_weight] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Risk Signals
		lineageTag: 2b1ff7e1-ef90-4c78-8785-f8b5e94b3ef0

	measure 'Eligible Central Adiposity Signal Rate' = DIVIDE ( SUMX ( FILTER ( analytic_cohort, analytic_cohort[guideline_like_eligible] = 1 ), analytic_cohort[mec_exam_weight] * analytic_cohort[central_adiposity_signal] ), SUMX ( FILTER ( analytic_cohort, analytic_cohort[guideline_like_eligible] = 1 ), analytic_cohort[mec_exam_weight] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Risk Signals
		lineageTag: fba88d9a-79b5-4c56-a072-f70a922aad58

